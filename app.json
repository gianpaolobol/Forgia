{
  "expo": {
    "name": "Forgia",
    "slug": "forgia-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.gianpaolofranceschini.forgia",
      "buildNumber": "2"
    },
    "android": {
      "package": "it.gianpaolofranceschini.forgia",
      "versionCode": 2
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Consenti a Forgia di usare il microfono per dettare le idee.",
          "speechRecognitionPermission": "Consenti a Forgia di trascrivere le idee che detti."
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
